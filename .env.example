# Copy to .env (scripts/setup.ps1 does this and fills random values). Never commit .env.
# Postgres password for the local Docker database (bound to 127.0.0.1 only).
POSTGRES_PASSWORD=change-me
# development | test | production. Production refuses demo controls and insecure cookies.
FLOWSENSE_ENV=development
# HMAC secret shared by the sandbox simulator and settlement ingestion (32+ chars).
FLOWSENSE_SANDBOX_EVENT_SECRET=replace-with-32-plus-random-characters
# Password for the synthetic demo accounts (12+ chars). Generated locally; not a production credential.
FLOWSENSE_DEMO_PASSWORD=replace-me-locally
# Demo controls (reset, sandbox counterparty simulator). Must be false in production.
FLOWSENSE_DEMO_CONTROLS_ENABLED=true
# Password for the designated clean "Start fresh" account fresh@flowsense.example (12+ chars; 24+ on a hosted demo). Unset = not created.
FLOWSENSE_FRESH_ACCOUNT_PASSWORD=replace-me-locally-too
# Cookies: false only for http://localhost development. true behind HTTPS.
FLOWSENSE_COOKIE_SECURE=false
# demo = offline deterministic assistant (no API key, no network). live = Anthropic Messages API with server-side tools.
FLOWSENSE_AI_MODE=demo
# Only used when FLOWSENSE_AI_MODE=live. Key from console.anthropic.com (API credit needed). Never commit it.
FLOWSENSE_ANTHROPIC_API_KEY=
# Recommended: claude-opus-5-5
FLOWSENSE_ANTHROPIC_MODEL=
# Google Gemini instead (free tier): FLOWSENSE_AI_PROVIDER=gemini plus a key and a Flash model ID from AI Studio.
# FLOWSENSE_AI_PROVIDER=gemini
# FLOWSENSE_GEMINI_API_KEY=
# FLOWSENSE_GEMINI_MODEL=
# Optional: other Gemini models when one is out of quota (auto | off | comma-separated IDs), default auto.
# FLOWSENSE_GEMINI_FALLBACK_MODELS=auto
# Optional: daily AI answers per user (default 200), quick answers when the AI is unavailable (default true),
# minutes to reuse an answer to the same question on unchanged records (default 15).
# FLOWSENSE_AI_MESSAGES_PER_USER_PER_DAY=200
# FLOWSENSE_AI_AUTO_FALLBACK=true
# FLOWSENSE_AI_ANSWER_CACHE_MINUTES=15
# Email for password reset and address confirmation: off | resend. Off = not configured (the UI says so).
FLOWSENSE_EMAIL_PROVIDER=off
FLOWSENSE_RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. FlowSense <no-reply@your-domain>
FLOWSENSE_EMAIL_FROM=
# Trusted origin used in emailed links, e.g. http://localhost:3000 or https://your-app.vercel.app
FLOWSENSE_PUBLIC_APP_URL=
# Exchange rates: erapi (free, no key, daily, ~160 currencies incl. BDT) | exchangerate_api (needs FLOWSENSE_FX_API_KEY) | ecb | off
FLOWSENSE_FX_PROVIDER=erapi
FLOWSENSE_FX_API_KEY=
