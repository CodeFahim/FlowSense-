# Copy to .env (scripts/setup.ps1 does this and fills random values). Never commit .env.
# Postgres password for the local Docker database (bound to 127.0.0.1 only).
POSTGRES_PASSWORD=change-me
# development | test | production. Production refuses demo controls and insecure cookies.
LIFELINE_ENV=development
# HMAC secret shared by the sandbox simulator and settlement ingestion (32+ chars).
LIFELINE_SANDBOX_EVENT_SECRET=replace-with-32-plus-random-characters
# Password for the synthetic demo accounts (12+ chars). Generated locally; not a production credential.
LIFELINE_DEMO_PASSWORD=replace-me-locally
# Demo controls (reset, sandbox counterparty simulator). Must be false in production.
LIFELINE_DEMO_CONTROLS_ENABLED=true
# Password for the designated clean "Start fresh" account fresh@lifeline.example (12+ chars; 24+ on a hosted demo). Unset = not created.
LIFELINE_FRESH_ACCOUNT_PASSWORD=replace-me-locally-too
# Cookies: false only for http://localhost development. true behind HTTPS.
LIFELINE_COOKIE_SECURE=false
# demo = offline deterministic assistant (no API key, no network). live = Anthropic Messages API with server-side tools.
LIFELINE_AI_MODE=demo
# Only used when LIFELINE_AI_MODE=live. Key from console.anthropic.com (API credit needed). Never commit it.
LIFELINE_ANTHROPIC_API_KEY=
# Recommended: claude-opus-5-5
LIFELINE_ANTHROPIC_MODEL=
# Google Gemini instead (free tier): LIFELINE_AI_PROVIDER=gemini plus a key and a Flash model ID from AI Studio.
# LIFELINE_AI_PROVIDER=gemini
# LIFELINE_GEMINI_API_KEY=
# LIFELINE_GEMINI_MODEL=
# Optional: other Gemini models when one is out of quota (auto | off | comma-separated IDs), default auto.
# LIFELINE_GEMINI_FALLBACK_MODELS=auto
# Optional: daily AI answers per user (default 200), quick answers when the AI is unavailable (default true),
# minutes to reuse an answer to the same question on unchanged records (default 15).
# LIFELINE_AI_MESSAGES_PER_USER_PER_DAY=200
# LIFELINE_AI_AUTO_FALLBACK=true
# LIFELINE_AI_ANSWER_CACHE_MINUTES=15
# Email for password reset and address confirmation: off | resend. Off = not configured (the UI says so).
LIFELINE_EMAIL_PROVIDER=off
LIFELINE_RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Lifeline <no-reply@your-domain>
LIFELINE_EMAIL_FROM=
# Trusted origin used in emailed links, e.g. http://localhost:3000 or https://your-app.vercel.app
LIFELINE_PUBLIC_APP_URL=
# Exchange rates: erapi (free, no key, daily, ~160 currencies incl. BDT) | exchangerate_api (needs LIFELINE_FX_API_KEY) | ecb | off
LIFELINE_FX_PROVIDER=erapi
LIFELINE_FX_API_KEY=
